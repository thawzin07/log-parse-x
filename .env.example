PROJECT_NAME=logparsex

# Docker-exposed ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
OLLAMA_PORT=11434

# PostgreSQL container credentials
POSTGRES_DB=logparsex
POSTGRES_USER=logparsex
POSTGRES_PASSWORD=logparsex

# Backend configuration
DATABASE_URL=postgresql+psycopg2://logparsex:logparsex@postgres:5432/logparsex
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend configuration
VITE_API_URL=http://localhost:8000

# LLM provider: ollama, openai, gemini, or none
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# Optional cloud fallback providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
